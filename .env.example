# ─── Database ─────────────────────────────────────────────────────────────────
# Pooled connection used by the app at runtime.
# On Neon: use the "Pooled connection" string from the dashboard.
# Add ?pgbouncer=true&connection_limit=1 when using Neon's built-in PgBouncer
# to prevent connection exhaustion in Vercel's serverless environment.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech:5432/DATABASE?schema=public&pgbouncer=true&connection_limit=1&connect_timeout=30"
# Direct / non-pooled connection — used only by prisma migrate deploy.
# On Neon: copy the "Direct connection" string (not the pooled one).
# If this is not set, the app falls back to DATABASE_URL at runtime (migrations still need it).
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech:5432/DATABASE?schema=public&connect_timeout=30"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="your-nextauth-secret-min-32-chars"
NEXTAUTH_URL="http://localhost:3000" # Set this to your Vercel/custom domain in production

# ─── Supabase Storage (file uploads) ───────────────────────────────────────────
# Create a public bucket (e.g. desk-media) and enable signed uploads per Supabase docs.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Optional: server-only project URL (defaults to NEXT_PUBLIC_SUPABASE_URL)
# SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_STORAGE_BUCKET="desk-media"
# Chat realtime uses Supabase Realtime Broadcast (same project). In the Supabase
# dashboard: Project Settings → Realtime → enable Realtime, and allow broadcast
# for public channels (or configure authorization to match your security model).

# ─── Resend (transactional email) ─────────────────────────────────────────────
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="noreply@yourdomain.com"

# ─── OneSignal (push notifications) ──────────────────────────────────────────
ONESIGNAL_APP_ID="00000000-0000-0000-0000-000000000000"
ONESIGNAL_REST_API_KEY="your-onesignal-rest-api-key"

# ─── Upstash Redis (rate limiting + TradingView webhook rate limiting) ────────
# Required in production for Phase 2 webhook rate limiting (30 req/min per IP).
# Without it the app still works but the webhook endpoint runs with no rate limit.
# AUDIT FIX: These two variables were present in lib/env.ts but missing from this file.
UPSTASH_REDIS_REST_URL="https://your-upstash-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# ─── Public app URL ───────────────────────────────────────────────────────────
# AUDIT FIX: NEXT_PUBLIC_APP_URL was referenced in lib/env.ts but missing here.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Contact / social link ───────────────────────────────────────────────────
NEXT_PUBLIC_CONTACT_LINK="https://t.me/yourusername"

# ─── Sentry error monitoring (optional) ──────────────────────────────────────
# 1. Create a project at https://sentry.io → Settings → Projects → Create Project → Next.js
# 2. Copy the DSN from Project Settings → Client Keys (DSN)
# 3. For source-map uploads in CI: Settings → Auth Tokens → Create Token (scope: project:releases)
# SENTRY_DSN and NEXT_PUBLIC_SENTRY_DSN should be the same value.
# Leave blank to disable Sentry (the app works without it).
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Used by @sentry/nextjs to upload source maps during `next build` in CI only.
# Do NOT commit this token; add it as a secret in your CI environment.
SENTRY_AUTH_TOKEN=""
# Sentry org slug and project slug (found in the project URL: sentry.io/org-slug/project-slug/)
SENTRY_ORG=""
SENTRY_PROJECT=""

# ─── Vercel (set automatically in Vercel deployments) ────────────────────────
# AUDIT FIX: VERCEL_URL is injected by Vercel at deploy time and used in
# lib/env.ts to infer NEXTAUTH_URL when it is not explicitly set. Do NOT set
# this locally — leave it commented out so the Vercel environment sets it.
# VERCEL_URL=
