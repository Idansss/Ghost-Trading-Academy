# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="your-nextauth-secret-min-32-chars"
NEXTAUTH_URL="http://localhost:3000" # Set this to your Vercel/custom domain in production

# ─── UploadThing (file uploads) ───────────────────────────────────────────────
UPLOADTHING_SECRET="sk_live_..."
UPLOADTHING_APP_ID="your-app-id"
# AUDIT FIX: CDN domain vars were used in lib/env.ts and next.config.mjs but
# absent from this example file. Leave blank to fall back to utfs.io defaults.
UPLOADTHING_CDN_DOMAIN=""
NEXT_PUBLIC_UPLOADTHING_CDN_DOMAIN=""

# ─── Resend (transactional email) ─────────────────────────────────────────────
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="noreply@yourdomain.com"

# ─── OneSignal (push notifications) ──────────────────────────────────────────
ONESIGNAL_APP_ID="00000000-0000-0000-0000-000000000000"
ONESIGNAL_REST_API_KEY="your-onesignal-rest-api-key"

# ─── Upstash Redis (rate limiting) ────────────────────────────────────────────
# AUDIT FIX: These two variables were present in lib/env.ts but missing from this file.
UPSTASH_REDIS_REST_URL="https://your-upstash-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# ─── Pusher (real-time chat) ──────────────────────────────────────────────────
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER=""
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER=""

# ─── Public app URL ───────────────────────────────────────────────────────────
# AUDIT FIX: NEXT_PUBLIC_APP_URL was referenced in lib/env.ts but missing here.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Contact / social link ───────────────────────────────────────────────────
NEXT_PUBLIC_CONTACT_LINK="https://t.me/yourusername"

# ─── Vercel (set automatically in Vercel deployments) ────────────────────────
# AUDIT FIX: VERCEL_URL is injected by Vercel at deploy time and used in
# lib/env.ts to infer NEXTAUTH_URL when it is not explicitly set. Do NOT set
# this locally — leave it commented out so the Vercel environment sets it.
# VERCEL_URL=
